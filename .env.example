# Copy this file to .env, keep .env private, and replace the placeholders.
# Compose reads project .env for interpolation. For host execution, either
# export the values or run `uv run --env-file .env ...`.
#
# Required for Compose bind-mount ownership. HOST_UID must be nonzero (root
# UID 0 is rejected by scripts/container-smoke.sh). Replace these examples
# with the output of `id -u` and `id -g` (macOS commonly uses 501/20; Linux
# often 1000).
HOST_UID=1000
HOST_GID=1000

# SQLite/feed defaults. Leave feed values blank when importing only TheirStack.
DATABASE_URL=data/jobs.sqlite3
JOB_SOURCE_BASE_URL=
JOB_SOURCE_API_KEY=

# Required for TheirStack preview/sync. Paid fetch remains disabled unless the
# CLI receives --paid-fetch or you deliberately change the boolean below.
THEIRSTACK_API_KEY=
THEIRSTACK_ENABLE_PAID_FETCH=false
THEIRSTACK_BASE_URL=https://api.theirstack.com

# Optional guarded inference. Without a key, unresolved safe fields remain
# manual; deterministic profile/resume answers still run.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=deepseek-v4-flash
OLLAMA_CLOUD_THINK=low

# Optional OMP RPC authentication. Keep these blank unless explicitly configured.
OMP_AUTH_BROKER_URL=
OMP_AUTH_BROKER_TOKEN=
OPENAI_API_KEY=

# Resume, application-profile preset/JSON, preferences, artifact root, and
# --headed are intentionally CLI arguments, not ambient environment settings.
