{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/application-decision.schema.json",
  "title": "Application decision",
  "description": "A bounded, evidence-aware decision for one observed application control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observationId",
    "fieldId",
    "controlReference",
    "fieldPolicy",
    "proposedAnswer",
    "answerSource",
    "evidenceReferences",
    "inferenceRationaleDigest",
    "inferenceEvidenceDigests",
    "proposedAction",
    "expectedRetainedState",
    "modelTier",
    "confidence",
    "reasonCode",
    "reobservationRequired",
    "automaticSubmissionEligible"
  ],
  "properties": {
    "observationId": {
      "$ref": "#/$defs/identifier"
    },
    "fieldId": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "controlReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "fieldPolicy": {
      "enum": [
        "subjective",
        "qualification",
        "legal",
        "demographic",
        "identity",
        "hard_fact"
      ]
    },
    "proposedAnswer": {
      "$ref": "#/$defs/jsonValue"
    },
    "answerSource": {
      "enum": [
        "memory",
        "profile",
        "resume",
        "agent_inference",
        "user"
      ]
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
      }
    },
    "inferenceRationaleDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inferenceEvidenceDigests": {
      "oneOf": [
        {
          "$ref": "#/$defs/inferenceEvidenceDigests"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposedAction": {
      "enum": [
        "fill_text",
        "clear",
        "select_option",
        "toggle",
        "upload_file",
        "click",
        "open_dialog",
        "close_dialog",
        "navigate",
        "wait",
        "reobserve"
      ]
    },
    "expectedRetainedState": {
      "$ref": "#/$defs/jsonValue"
    },
    "modelTier": {
      "enum": [
        "cheap",
        "standard",
        "strong",
        "highest"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "reobservationRequired": {
      "type": "boolean"
    },
    "automaticSubmissionEligible": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "answerSource": {
            "const": "agent_inference"
          }
        }
      },
      "then": {
        "required": [
          "inferenceRationaleDigest",
          "inferenceEvidenceDigests"
        ],
        "properties": {
          "inferenceRationaleDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "inferenceEvidenceDigests": {
            "$ref": "#/$defs/inferenceEvidenceDigests"
          },
          "evidenceReferences": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answerSource": {
            "enum": [
              "memory",
              "profile",
              "resume"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidenceReferences": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answerSource": {
            "not": {
              "const": "agent_inference"
            }
          }
        }
      },
      "then": {
        "properties": {
          "inferenceRationaleDigest": {
            "type": "null"
          },
          "inferenceEvidenceDigests": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fieldPolicy": {
            "enum": [
              "legal",
              "demographic",
              "identity",
              "hard_fact"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "answerSource": {
            "enum": [
              "memory",
              "profile",
              "resume",
              "user"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposedAction": {
            "enum": [
              "fill_text",
              "clear",
              "select_option",
              "toggle",
              "upload_file",
              "click",
              "open_dialog"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "fieldId": {
            "$ref": "#/$defs/identifier"
          },
          "controlReference": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposedAction": {
            "enum": [
              "close_dialog",
              "navigate",
              "wait",
              "reobserve"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "fieldId": {
            "type": "null"
          },
          "controlReference": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "inferenceEvidenceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resumeSha256",
        "jobDescriptionSha256"
      ],
      "properties": {
        "resumeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "jobDescriptionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 65536,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
