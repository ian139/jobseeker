# Current job-sync environment variable names.
# Copy values from your existing .env; do not commit real API keys.

# TheirStack sync. Paid fetches only run when ENABLE_PAID_FETCH=true.
THEIRSTACK_API_KEY=
ENABLE_PAID_FETCH=false
THEIRSTACK_BASE_URL=https://api.theirstack.com

# Local SQLite database for job-sync.
JOB_SYNC_DB_PATH=data/job_sync.sqlite3

# Optional read-only external job feed importer.
JOB_SOURCE_BASE_URL=
JOB_SOURCE_API_KEY=

# Optional Ollama Cloud DeepSeek resolver for live apply dry-runs.
# OLLAMA_API_KEY is also accepted as a fallback for OLLAMA_CLOUD_API_KEY.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=deepseek-v4-pro
# Optional request timeout override, seconds.
# OLLAMA_CLOUD_TIMEOUT_SECONDS=30

# Deprecated old names from the archived job_scraper app; leave unset for current job-sync:
# JOB_SCRAPER_DB_PATH
# JOB_SOURCE
# PUBLIC_JSON_BASE_URL
# LLM_API_KEY
# LLM_MODEL
# LLM_BASE_URL
# APPLICATION_PACK_DIR
# APPLICATION_BROWSER_HEADLESS
# APPLICATION_TIMEOUT_MS
