{
  "version": "2026-07-10.wave-b",
  "ascii_codepoint_ranges": [[9, 10], [13, 13], [32, 126]],
  "caps": {
    "max_descriptors": 32,
    "max_descriptor_bytes": 2048,
    "max_descriptor_aggregate_bytes": 8192,
    "max_options": 200,
    "max_option_bytes": 2048,
    "max_option_aggregate_bytes": 65536
  },
  "greenhouse_route_policy": {
    "version": "2026-07-10.greenhouse-routes.v1",
    "interactive_frame_origins": [
      "https://boards.greenhouse.io",
      "https://job-boards.greenhouse.io"
    ],
    "automated_initial_get": {
      "methods": ["GET"],
      "routes": [
        {
          "class": "hosted",
          "hosts": ["boards.greenhouse.io", "job-boards.greenhouse.io"],
          "path_template": "/{board}/jobs/{job}",
          "path_patterns": {"board": "ascii_slug", "job": "digits"},
          "identity": ["board", "job"],
          "query_keys": ["gh_src"]
        },
        {
          "class": "embed",
          "hosts": ["boards.greenhouse.io"],
          "path": "/embed/job_app",
          "identity": ["for", "token"],
          "query_keys": ["for", "token", "gh_src"],
          "required_query": ["for", "token"],
          "query_patterns": {"for": "ascii_slug", "token": "digits"}
        },
        {
          "class": "shortlink",
          "hosts": ["grnh.se"],
          "path_template": "/{slug}",
          "path_patterns": {"slug": "ascii_slug"},
          "identity": ["slug", "slug"],
          "query_keys": []
        }
      ]
    },
    "approved_static_get_head": {
      "methods": ["GET", "HEAD"],
      "hosts": ["boards.greenhouse.io", "job-boards.greenhouse.io", "job-boards.cdn.greenhouse.io"],
      "path_prefixes": {
        "boards.greenhouse.io": ["/assets/"],
        "job-boards.greenhouse.io": ["/assets/"],
        "job-boards.cdn.greenhouse.io": ["/assets/"]
      },
      "types": ["stylesheet", "script", "image", "font", "media"],
      "path_caps": {"max_path_bytes": 2048, "max_query_bytes": 2048}
    },
    "human_only_form_actions": {
      "methods": ["GET", "POST"],
      "routes": [
        {
          "class": "hosted_form",
          "hosts": ["boards.greenhouse.io", "job-boards.greenhouse.io"],
          "path_template": "/{board}/jobs/{job}",
          "path_patterns": {"board": "ascii_slug", "job": "digits"},
          "identity": ["board", "job"],
          "query_keys": ["gh_src"]
        },
        {
          "class": "embed_form",
          "hosts": ["boards.greenhouse.io"],
          "path": "/embed/job_app",
          "identity": ["for", "token"],
          "query_keys": ["for", "token", "gh_src"],
          "required_query": ["for", "token"],
          "query_patterns": {"for": "ascii_slug", "token": "digits"}
        }
      ]
    },
    "post_human_confirmation": {
      "methods": ["GET"],
      "hosts": ["boards.greenhouse.io", "job-boards.greenhouse.io"],
      "path_template": "/{board}/jobs/{job}/confirmation",
      "path_patterns": {"board": "ascii_slug", "job": "digits"},
      "identity": ["board", "job"],
      "query_keys": ["gh_src"],
      "route": "same_board_job_confirmation",
      "requires_human_permit": true,
      "requires_same_board_job": true
    },
    "final_like_match": "ascii_word_boundary",
    "final_like_tokens": ["submit", "complete", "confirm", "finish", "send", "final"],
    "redirect_caps": {
      "max_redirects": 10,
      "max_static_requests": 200,
      "max_static_bytes": 20971520
    },
    "public_host_constraints": {
      "scheme": "https",
      "ports": [443],
      "reject_userinfo": true,
      "reject_fragments": true,
      "reject_private": true,
      "allowed_hosts": ["boards.greenhouse.io", "job-boards.greenhouse.io", "job-boards.cdn.greenhouse.io", "grnh.se"]
    },
    "renderer_patterns": {
      "hosted": {
        "document": "https://job-boards.greenhouse.io/{board}/jobs/{job}",
        "form_action": "https://job-boards.greenhouse.io/{board}/jobs/{job}",
        "form_method": "GET"
      },
      "embed": {
        "document": "https://boards.greenhouse.io/embed/job_app?for={board}&token={job}",
        "form_action": "https://boards.greenhouse.io/embed/job_app?for={board}&token={job}",
        "form_method": "POST"
      }
    },
    "parity_vectors": [
      {"name": "hosted_board", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123", "method": "GET", "expected": "allow:hosted"},
      {"name": "hosted_job_board", "operation": "initial", "url": "https://job-boards.greenhouse.io/example/jobs/123?gh_src=fixture", "method": "GET", "expected": "allow:hosted"},
      {"name": "embed_renderer", "operation": "initial", "url": "https://boards.greenhouse.io/embed/job_app?for=example&token=123", "method": "GET", "expected": "allow:embed"},
      {"name": "shortlink_redirect", "operation": "initial", "url": "https://grnh.se/example", "method": "GET", "expected": "allow:shortlink"},
      {"name": "finalist_boundary", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123?gh_src=finalist", "method": "GET", "expected": "allow:hosted"},
      {"name": "confirmation_boundary", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123?gh_src=confirmation", "method": "GET", "expected": "allow:hosted"},
      {"name": "submit_boundary", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123?gh_src=submit", "method": "GET", "expected": "deny:final_like_route"},
      {"name": "complete_boundary", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123?gh_src=complete", "method": "GET", "expected": "deny:final_like_route"},
      {"name": "hosted_cdn_asset", "operation": "request", "url": "https://job-boards.cdn.greenhouse.io/assets/application-f00ba4.js", "method": "GET", "request_class": "static", "resource_type": "script", "expected": "allow:static"},
      {"name": "static_literal_dot_segment", "operation": "request", "url": "https://job-boards.cdn.greenhouse.io/assets/../tracker.js", "method": "GET", "request_class": "static", "resource_type": "script", "expected": "deny:unsafe_path"},
      {"name": "static_encoded_dot_segment", "operation": "request", "url": "https://job-boards.cdn.greenhouse.io/assets/%2e%2e/tracker.js", "method": "GET", "request_class": "static", "resource_type": "script", "expected": "deny:unsafe_path"},
      {"name": "static_encoded_backslash", "operation": "request", "url": "https://job-boards.cdn.greenhouse.io/assets/%5ctracker.js", "method": "GET", "request_class": "static", "resource_type": "script", "expected": "deny:unsafe_path"},
      {"name": "static_malformed_escape", "operation": "request", "url": "https://job-boards.cdn.greenhouse.io/assets/%ZZ.js", "method": "GET", "request_class": "static", "resource_type": "script", "expected": "deny:invalid_path_encoding"},
      {"name": "hosted_cdn_non_asset", "operation": "request", "url": "https://job-boards.cdn.greenhouse.io/tracker.js", "method": "GET", "request_class": "static", "resource_type": "script", "expected": "deny:unsupported_static_path"},
      {"name": "shortlink_static_denied", "operation": "request", "url": "https://grnh.se/assets/application.js", "method": "GET", "request_class": "static", "resource_type": "script", "expected": "deny:unsupported_static_host"},
      {"name": "unknown_host", "operation": "initial", "url": "https://custom.example/jobs/123", "method": "GET", "expected": "deny:unsupported_host"},
      {"name": "duplicate_query", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123?gh_src=a&gh_src=b", "method": "GET", "expected": "deny:duplicate_query"},
      {"name": "final_token", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123?next=confirm", "method": "GET", "expected": "deny:final_like_route"},
      {"name": "final_token_boundary", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123?gh_src=finalist", "method": "GET", "expected": "allow:hosted"},
      {"name": "human_form_ownership", "operation": "form", "url": "https://job-boards.greenhouse.io/example/jobs/123", "method": "POST", "expected": "human:field_ownership"},
      {"name": "confirmation_same_job_permitted", "operation": "request", "url": "https://job-boards.greenhouse.io/example/jobs/123/confirmation", "method": "GET", "request_class": "post_human_confirmation", "page_url": "https://job-boards.greenhouse.io/example/jobs/123", "human_permit": true, "expected": "allow:post_human_confirmation"},
      {"name": "confirmation_other_job", "operation": "request", "url": "https://job-boards.greenhouse.io/example/jobs/124/confirmation", "method": "GET", "request_class": "post_human_confirmation", "page_url": "https://job-boards.greenhouse.io/example/jobs/123", "human_permit": true, "expected": "deny:same_board_job_required"},
      {"name": "method_mismatch", "operation": "initial", "url": "https://boards.greenhouse.io/example/jobs/123", "method": "POST", "expected": "deny:method_mismatch"}
    ]
  },
